# 当前提交核心（user_agent.py / main.py / demo.py）
# 从 https://internlm.intern-ai.org.cn/api-token 获取 token。
INTERN_API_KEY=
INTERN_API_BASE=https://chat.intern-ai.org.cn/api/v1/chat/completions
# 当前默认；formal 还允许已登记的 intern-s1-pro 与 intern-s2-preview。
INTERN_MODEL=intern-s1
# 默认开启参赛合规模式；allowlist 外模型只有明确非提交实验才可设为 0。
COMPETITION_MODE=1
LOCAL_MAX_CONCURRENCY=3
