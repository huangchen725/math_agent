# Intern-S1 API 配置
# 从 https://internlm.intern-ai.org.cn/api-token 获取 token，填到下面
# 未填（留空）时自动进入 mock 模式，可无 key 开发调试
INTERN_S1_API_KEY=
INTERN_S1_BASE_URL=https://chat.intern-ai.org.cn/api/v1/
INTERN_S1_MODEL=intern-s1
THINKING_MODE=true

# 是否强制 mock 模式（true=即使有 key 也用 mock；留空/false=有 key 用真实）
MOCK_MODE=
